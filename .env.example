# ---------------------------------------------------------------------------
# Katalis POS — salin ke .env.local lalu isi nilainya.
# Jangan commit .env.local.
# ---------------------------------------------------------------------------

# Kosongkan atau pakai pglite://./.data/pglite untuk mode demo (tanpa setup).
# Untuk produksi gunakan PostgreSQL Server:
#   DATABASE_URL=postgres://user:password@host:5432/katalis
DATABASE_URL=pglite://./.data/pglite

# Wajib diisi (minimal 16 karakter) saat NODE_ENV=production + PostgreSQL Server.
# Buat dengan: npm run secrets:generate
SESSION_SECRET=
RECEIPT_SIGNING_KEY=

# Opsional
STORE_NAME=Katalis Mart
